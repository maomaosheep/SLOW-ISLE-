.detail-page{padding-bottom:calc(150rpx + env(safe-area-inset-bottom))}.photo{height:530rpx;position:relative}.photo>image{width:100%;height:100%}.photo-note{position:absolute;right:30rpx;bottom:24rpx;background:rgba(248,245,239,.92);padding:9rpx 16rpx;font-family:Georgia,serif;font-size:21rpx;letter-spacing:2rpx}.detail-body{padding-top:36rpx}.title-line{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.product-title{font-size:48rpx;line-height:1.4}.english{font-family:Georgia,serif;font-size:23rpx;color:#82776c;letter-spacing:2rpx;margin:12rpx 0 20rpx}.description{font-size:26rpx;color:#82776c;line-height:1.9;border-bottom:1rpx solid #e6ded3;padding-bottom:28rpx;margin-bottom:28rpx}.group{margin-top:28rpx}.group-title{font-size:26rpx;margin-bottom:16rpx}.options{display:flex;gap:16rpx;flex-wrap:wrap}.option{flex:1;min-width:150rpx;border:1rpx solid #ddd1c2;border-radius:6rpx;padding:18rpx 10rpx;font-size:25rpx;text-align:center}.option.selected{background:#e9ded0;border-color:#9d7c5d;color:#63442d}.detail-footer{display:flex;align-items:center;gap:30rpx}.detail-footer .primary{flex:1;font-size:27rpx}
