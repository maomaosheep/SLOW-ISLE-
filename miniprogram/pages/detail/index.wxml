<view class="detail-page">
  <view wx:if="{{loading}}" class="state"><view class="state-copy">正在准备这一杯…</view></view>
  <view wx:elif="{{error}}" class="state"><view class="state-title serif">稍等一下。</view><view class="state-copy">{{error}}</view><button class="secondary" bindtap="backToMenu">返回菜单</button></view>
  <block wx:elif="{{product}}"><view class="photo"><image class="product-photo" src="{{product.image}}" mode="aspectFill"/><text class="photo-note">A LITTLE SWEETNESS.</text></view><view class="pad detail-body"><view class="title-line"><view class="serif product-title">{{product.name}}</view><text class="price money">¥{{price}}</text></view><view class="english">{{product.english_name}}</view><view class="description">{{product.description}}</view><view wx:for="{{groups}}" wx:key="key" wx:for-item="group" class="group"><view class="group-title">{{group.title}}</view><view class="options"><button wx:for="{{group.choices}}" wx:key="label" class="option {{selected[group.key] === item.label ? 'selected' : ''}}" data-group="{{group.key}}" data-label="{{item.label}}" bindtap="select">{{item.label}}<text class="numeric">{{item.extra_label}}</text></button></view></view><view wx:if="{{!groups.length}}" class="note-box">每日现做，让咖啡与小食一起慢慢享用。</view></view><view class="fixed-footer detail-footer"><view class="stepper"><button data-delta="-1" bindtap="changeQty" aria-label="减少数量">−</button><text class="quantity-number">{{quantity}}</text><button data-delta="1" bindtap="changeQty" aria-label="增加数量">+</button></view><button class="primary" disabled="{{!isOpen}}" bindtap="add">{{isOpen ? '加入购物袋' : '门店暂未接单'}}<text class="arrow">+</text></button></view></block>
</view>
