ckground:transparent;color:#705b46;border:1rpx solid #c9b9a7}.product-bottom .plus{flex:0 0 48rpx;width:48rpx;min-width:48rpx;height:48rpx;min-height:48rpx}.no-results{padding:70rpx 10rpx;font-size:24rpx;color:#82776c}.list-end{text-align:center;color:#b0a18e;font-size:20rpx;padding:40rpx 0}.bag-bar{position:fixed;bottom:20rpx;left:28rpx;right:28rpx;height:104rpx;padding:0 24rpx;background:#302720;color:#f8f5ef;border-radius:10rpx;display:flex;align-items:center;z-index:10}
