.hero{height:610rpx;position:relative;background:#473b30;overflow:hidden}.hero>image{width:100%;height:100%}.scrim{position:absolute;inset:0;background:linear-gradient(90deg,rgba(30,26,20,.55),rgba(30,26,20,.08))}.hero-copy{position:absolute;top:56rpx;left:44rpx;right:30rpx;color:#fff7ea}.hero-eyebrow{font-family:Georgia,serif;font-size:20rpx;letter-spacing:4rpx}.hero-title{font-size:68rpx;line-height:1.55;letter-spacing:6rpx;margin:30rpx 0 22rpx}.hero-sub{font-size:24rpx;letter-spacing:2rpx;color:#e9ded0}.hero-bottom{position:absolute;bottom:36rpx;left:44rpx;right:44rpx;border-top:1rpx solid rgba(244,233,219,.5);padding-top:25rpx;display:flex;justify-content:space-between;font-family:Georgia,serif;font-size:20rpx;letter-spacing:2rpx;color:#f4e9db}.store{display:flex;justify-content:space-between;align-items:center;margin-bottom:35rpx}.store-name{font-size:30rpx}.hours{font-size:23rpx;color:#82776c;margin-top:10rpx}.dot{color:#627056}.dot.closed{color:#ac8c72}.recommend{display:flex;align-items:center;gap:26rpx}.recommend-photo{width:160rpx;height:170rpx;border-radius:8rpx;flex:0 0 160rpx}.recommend-info{flex:1;min-width:0;font-size:28rpx}.recommend-name{font-size:29rpx;line-height:1.5;overflow-wrap:break-word}.flavor{font-size:22rpx;margin:10rpx 0 12rpx}.brand-end{text-align:center;padding:60rpx 0 20rpx;color:#82776c}.brand-end .eyebrow{font-size:18rpx}.brand-end view{font-size:22rpx;margin-top:14rpx}

.manager-section{margin-top:52rpx;padding-top:10rpx;border-top:1rpx solid #e6ded3}.manager-title{margin-top:10rpx}.manager-grid{display:flex;gap:24rpx}.manager-card{width:calc((100% - 24rpx)/2);min-width:0;background:#f0eae1;border-radius:12rpx;overflow:hidden}.manager-photo{width:100%;height:245rpx}.manager-info{padding:22rpx}.manager-name{font-size:27rpx;font-weight:500;line-height:1.5;min-height:42rpx}.manager-flavor{font-size:21rpx;line-height:1.6;color:#82776c;margin:10rpx 0 20rpx;min-height:66rpx}.manager-bottom{display:flex;align-items:center;justify-content:space-between;gap:8rpx}.manager-bottom .plus{flex-basis:48rpx;width:48rpx;min-width:48rpx;height:48rpx;min-height:48rpx;font-size:30rpx}.shuffle{font-size:24rpx;color:#8e674b;padding:16rpx 0 16rpx 20rpx;flex-shrink:0}
