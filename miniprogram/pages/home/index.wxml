<view class="page">
  <view class="hero"><image src="/assets/hero.jpg" mode="aspectFill" /><view class="scrim"></view><view class="hero-copy"><text class="hero-eyebrow">GOOD COFFEE. SLOW MOMENTS.</text><view class="hero-title serif"><view>慢一点，</view><view>好喝的在这里。</view></view><text class="hero-sub">现磨 · 现做 · 为日常留白</text></view><view class="hero-bottom"><text>YOUR DAILY COFFEE RITUAL</text><text>↗</text></view></view>
  <view wx:if="{{loading && !store}}" class="state"><view class="state-copy">正在为你准备菜单…</view></view>
  <view wx:elif="{{error}}" class="state"><view class="state-title serif">稍等，香气还在路上。</view><view class="state-copy">{{error}}</view><button class="secondary" bindtap="retry">重新连接</button></view>
  <view wx:elif="{{store}}" class="pad">
    <view class="store"><view><view class="store-name">{{store.name}}</view><view class="hours"><text class="dot {{store.is_open ? '' : 'closed'}}">●</text> {{store.is_open ? '营业中' : '暂未接单'}}　{{store.hours}}</view></view><text class="pill">到店自取</text></view>
    <button class="primary" bindtap="orderNow">点一杯喜欢的 <text class="arrow">↗</text></button>
    <view wx:if="{{featured}}"><view class="section-head"><text class="title serif">今日的偏爱</text><text class="eyebrow">DAILY FAVORITE</text></view><view class="recommend" bindtap="showFeatured"><image class="product-photo recommend-photo" src="{{featured.image}}" mode="aspectFill"/><view class="recommend-info"><view class="recommend-name">{{featured.name}}</view><view class="muted flavor">{{featured.flavor}}</view><text class="price money">¥{{featured.price}}</text></view><view class="plus quantity-symbol" role="button" aria-label="选择推荐商品"></view></view></view>
    <view wx:if="{{recommendations.length}}" class="manager-section"><view class="section-head"><view><text class="eyebrow">CHOSEN FOR YOU</text><view class="title serif manager-title">店长推荐</view></view><view class="shuffle" role="button" bindtap="shuffleRecommendations">换两杯 ↻</view></view><view class="manager-grid"><view wx:for="{{recommendations}}" wx:key="id" class="manager-card" data-id="{{item.id}}" bindtap="choose"><image class="manager-photo product-photo" src="{{item.image}}" mode="aspectFill"/><view class="manager-info"><view class="manager-name">{{item.name}}</view><view class="manager-flavor">{{item.flavor}}</view><view class="manager-bottom"><text class="price money">¥{{item.price}}</text><view class="plus quantity-symbol" role="button" aria-label="选择这款咖啡"></view></view></view></view></view></view>
    <view class="brand-end"><text class="eyebrow">A SMALL PAUSE IN YOUR DAY.</text><view>{{store.announcement}}</view></view>
  </view>
</view>
