<view class="pad orders-page"><view class="heading"><view class="serif">你的咖啡时刻</view><text class="eyebrow">YOUR DAILY RITUALS</text></view><view class="filters"><button data-tab="all" bindtap="selectTab" class="{{activeTab === 'all' ? 'selected' : ''}}">全部订单</button><button data-tab="ongoing" bindtap="selectTab" class="{{activeTab === 'ongoing' ? 'selected' : ''}}">进行中</button><button data-tab="reserved" bindtap="selectTab" class="{{activeTab === 'reserved' ? 'selected' : ''}}">预约单</button></view><view wx:if="{{error}}" class="note-box">{{error}}<button class="text-button" bindtap="retry">点击重试</button></view><view wx:for="{{visible}}" wx:key="id" class="order-card" data-id="{{item.id}}" bindtap="detail"><view class="order-top"><text>{{item.store_name}}</text><text class="badge">{{item.status_label}}</text></view><view wx:if="{{item.scheduled_for}}" class="reservation-line">预约 <text class="numeric">{{item.pickup_label}}</text> 取餐</view><view class="order-products"><image class="product-photo" src="{{item.items[0].image}}" mode="aspectFill"/><view class="product-names"><view wx:for="{{item.items}}" wx:for-item="product" wx:key="id" wx:if="{{index < 2}}">{{product.product_name}} ×<text class="quantity-number">{{product.quantity}}</text></view><view wx:if="{{item.items.length > 2}}">等 {{item.items.length}} 项商品</view></view></view><view class="order-bottom"><text class="numeric">{{item.date_label}}</text><view class="order-amount"><text class="money money-total">¥{{item.total}}</text><text>查看 →</text></view></view></view><view wx:if="{{!visible.length && !loading && !error}}" class="state"><view class="empty-icon">☕</view><view class="state-title serif">还没有咖啡时刻。</view><view class="state-copy">一杯好咖啡，值得一点等待。</view><button class="secondary" bindtap="menu">去点一杯</button></view><view wx:if="{{loading}}" class="loading-text">正在查看你的订单…</view><view wx:elif="{{orders.length}}" class="footer-note">{{hasMore ? '上拉查看更多订单' : '— 每一杯，都是一个小小的日常 —'}}</view></view>
