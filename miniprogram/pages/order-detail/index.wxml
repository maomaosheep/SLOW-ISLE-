<view class="order-detail pad"><view wx:if="{{loading}}" class="state"><view class="state-copy">正在查看制作进度…</view></view><view wx:elif="{{error && !order}}" class="state"><view class="state-copy">{{error}}</view><button class="secondary" bindtap="retry">重试</button></view><block wx:if="{{order}}"><view class="eyebrow">YOUR COFFEE MOMENT</view><view class="status-title serif">{{order.status === 'cancelled' ? '下次，再慢慢来。' : order.status === 'completed' ? '愿这杯，刚刚好。' : order.status === 'ready' ? '你的咖啡，做好了。' : created ? '下单成功，慢慢等一杯。' : '好咖啡，正在发生。'}}</view><view class="status-text">{{statusText}}</view><view wx:if="{{error}}" class="note-box">{{error}}，正在尝试更新进度。</view><view wx:if="{{step >= 0}}" class="pickup"><view class="eyebrow">到店自取 · 取餐码</view><view class="pickup-code pickup-number" bindtap="copyCode">{{order.pickup_code}}</view><view class="badge">{{order.status_label}}</view><view class="pickup-tip">{{order.store_name}} · 预计制作约 {{order.pickup_minutes}} 分钟</view></view><view wx:if="{{step >= 0}}" class="progress"><view class="{{step >= 0 ? 'done' : ''}}"><text>●</text>待接单</view><view class="{{step >= 1 ? 'done' : ''}}"><text>●</text>制作中</view><view class="{{step >= 2 ? 'done' : ''}}"><text>●</text>待取餐</view><view class="{{step >= 3 ? 'done' : ''}}"><text>●</text>已完成</view></view><view class="store-detail"><view>{{order.store_name}}</view><text>{{order.store_address}}</text></view><view wx:for="{{order.items}}" wx:key="id" class="item"><image class="product-photo" src="{{item.image}}" mode="aspectFill"/><view class="info"><view>{{item.product_name}}</view><view class="muted">{{item.specification || '每日现做'}}</view><view class="muted">× <text class="quantity-number">{{item.quantity}}</text></view></view><text class="money">¥{{item.subtotal}}</text></view><view class="detail-line"><text>取餐称呼</text><text>{{order.customer_name || '未填写'}}</text></view><view wx:if="{{order.note}}" class="detail-line"><text>备注</text><text>{{order.note}}</text></view><view class="detail-line"><text>下单时间</text><text class="numeric">{{order.date_label}}</text></view><view class="total-line"><text>合计</text><text class="money money-total">¥{{order.total}}</text></view><view class="actions"><button class="primary" bindtap="menu">再点一杯 <text class="arrow">↗</text></button><button wx:if="{{order.status === 'pending'}}" class="secondary" loading="{{cancelling}}" disabled="{{cancelling}}" bindtap="cancel">取消订单</button><button class="text-button" bindtap="orders">查看全部订单 →</button></view><view class="footer-note">页面每 10 秒更新制作进度，可下拉刷新。</view></block></view>
