.order-detail{padding-bottom:60rpx}.status-title{font-size:49rpx;letter-spacing:2rpx;line-height:1.5;margin:20rpx 0}.status-text{font-size:26rpx;color:#82776c;line-height:1.9;margin-bottom:40rpx}.pickup{background:#ede6dc;border:1rpx solid #dfd3c4;border-radius:8rpx;padding:36rpx 20rpx;text-align:center}.pickup .eyebrow{font-family:inherit;font-size:23rpx;letter-spacing:3rpx}.pickup-code{margin:20rpx 0;word-break:break-all}.pickup-tip{font-size:22rpx;color:#82776c;margin-top:24rpx}.progress{display:flex;justify-content:space-between;margin:38rpx 0 42rpx;font-size:23rpx;color:#b5a898;position:relative}.progress::before{content:"";position:absolute;left:30rpx;right:30rpx;top:15rpx;height:1rpx;background:#e1d5c5;z-index:-1}.progress>view{text-align:center;background:#f8f5ef;padding:0 12rpx}.progress text{display:block;font-size:20rpx;margin-bottom:10rpx}.progress .done{color:#70533b}.store-detail{font-size:28rpx;padding:28rpx 0;border-top:1rpx solid #e6ded3;border-bottom:1rpx solid #e6ded3}.store-detail text{display:block;color:#82776c;font-size:24rpx;margin-top:8rpx}.item{display:flex;gap:20rpx;padding:28rpx 0;border-bottom:1rpx solid #e6ded3;align-items:flex-start;font-size:27rpx}.item>image{width:110rpx;height:120rpx;border-radius:5rpx}.item>.info{flex:1;min-width:0}.item .muted{font-size:23rpx;margin-top:8rpx}.item>text{flex-shrink:0}.detail-line{display:flex;justify-content:space-between;gap:25rpx;padding:22rpx 0;border-bottom:1rpx solid #e6ded3;font-size:24rpx;color:#82776c}.detail-line text:last-child{text-align:right;overflow-wrap:anywhere}.total-line{display:flex;justify-content:space-between;align-items:center;padding:28rpx 0;font-size:26rpx}.actions .secondary{margin-top:20rpx}.actions .text-button{text-align:center;width:100%;margin-top:15rpx}
