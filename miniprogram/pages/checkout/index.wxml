<view class="checkout-page">
  <view wx:if="{{loading}}" class="state"><view class="state-copy">正在确认你的这一杯…</view></view>
  <view wx:elif="{{error}}" class="state"><view class="state-title serif">稍等一下。</view><view class="state-copy">{{error}}</view><button class="secondary" bindtap="retry">重新连接</button></view>
  <view wx:elif="{{!items.length}}" class="state"><view class="state-title serif">购物袋还是空的。</view><view class="state-copy">去选一杯喜欢的咖啡吧。</view><button class="secondary" bindtap="menu">去点一杯</button></view>
  <block wx:elif="{{store}}"><view class="pad"><view class="checkout-title serif">好咖啡，即将发生。</view><view class="eyebrow subtitle">TAKE A MOMENT. TAKE A COFFEE.</view><view wx:if="{{pending}}" class="note-box pending-tip">上次提交结果待确认。点击下方按钮恢复同一笔订单，避免重复下单。</view><view wx:if="{{stockBlocked}}" class="stock-notice">购物袋有缺货商品，请返回菜单移除后再下单。</view><view class="pickup-store"><view>到店自取 · {{store.name}}</view><view class="muted">{{store.address}}</view><view class="muted">{{pickupMode === 'scheduled' ? '预约商品按约定时间取餐，请留意订单状态' : '下单后约 ' + store.pickup_minutes + ' 分钟可取，请留意订单状态'}}</view></view><view class="pickup-section">
      <view class="pickup-heading"><text>取餐时间</text><text class="pickup-limit">最长预约 24 小时</text></view>
      <view class="pickup-switch">
        <view role="button" aria-disabled="{{pickupRequired || pending}}" class="pickup-mode {{pickupMode === 'asap' ? 'active' : ''}} {{pickupRequired ? 'unavailable' : ''}}" data-mode="asap" bindtap="changePickupMode">尽快制作</view>
        <view role="button" aria-disabled="{{pending}}" class="pickup-mode {{pickupMode === 'scheduled' ? 'active' : ''}}" data-mode="scheduled" bindtap="changePickupMode">预约取餐</view>
      </view>
      <view wx:if="{{pickupRequired}}" class="pickup-hint">含需提前备货的商品，整单至少提前 {{leadMinutes}} 分钟预约。</view>
      <block wx:if="{{pickupMode === 'scheduled'}}">
        <view wx:if="{{pending}}" class="pickup-choice numeric">{{pickupLabel}}</view>
        <picker wx:elif="{{pickupSlots.length}}" mode="selector" range="{{pickupSlots}}" range-key="label" value="{{pickupIndex}}" bindchange="selectPickup">
          <view class="pickup-choice"><view><text class="pickup-choice-title">到店取餐</text><text class="numeric">{{pickupLabel}}</text></view><text class="pickup-choice-arrow">⌄</text></view>
        </picker>
        <view wx:else class="pickup-hint">未来 24 小时暂无可约时段，请稍后再试或联系门店。</view>
        <text class="pickup-footnote">仅可选择营业时段；整单按所选时间取餐。</text>
      </block>
    </view><view wx:for="{{items}}" wx:key="key" class="order-item"><image class="product-photo" src="{{item.image}}" mode="aspectFill"/><view class="item-info"><view>{{item.name}}</view><view class="muted">{{item.specification || '每日现做'}}</view><view class="muted">× <text class="quantity-number">{{item.quantity}}</text></view></view><text class="item-price money">¥{{item.subtotal}}</text></view><view class="field"><text>取餐称呼</text><input maxlength="20" value="{{customerName}}" disabled="{{pending}}" placeholder="怎么称呼你（选填）" bindinput="nameInput"/></view><view class="field"><text>给咖啡师留言</text><input maxlength="200" value="{{note}}" disabled="{{pending}}" placeholder="口味偏好等（选填）" bindinput="noteInput"/></view><view class="notice">请确认门店与商品。提交后可在「订单」查看制作进度，凭取餐码到店领取。</view></view><view class="fixed-footer"><view class="total-row"><text>共 {{count}} 件商品</text><view>合计 <text class="total money money-total">¥{{total}}</text></view></view><button class="primary compact-action" size="default" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || stockBlocked || (!store.is_open && !pending) || (!pending && pickupMode === 'scheduled' && !pickupSlots.length)}}"><text class="action-label">{{pending ? '确认上次提交' : stockBlocked ? '请先移除缺货商品' : store.is_open ? (pickupMode === 'scheduled' ? '确认预约下单' : '确认下单') : '门店暂未接单'}}</text></button><view class="footer-note">直接提交订单 · 无在线支付</view></view></block>
</view>
