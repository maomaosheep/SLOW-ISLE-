<view class="checkout-page">
  <view wx:if="{{loading}}" class="state"><view class="state-copy">正在确认你的这一杯…</view></view>
  <view wx:elif="{{error}}" class="state"><view class="state-title serif">稍等一下。</view><view class="state-copy">{{error}}</view><button class="secondary" bindtap="retry">重新连接</button></view>
  <view wx:elif="{{!items.length}}" class="state"><view class="state-title serif">购物袋还是空的。</view><view class="state-copy">去选一杯喜欢的咖啡吧。</view><button class="secondary" bindtap="menu">去点一杯</button></view>
  <block wx:elif="{{store}}"><view class="pad"><view class="checkout-title serif">好咖啡，即将发生。</view><view class="eyebrow subtitle">TAKE A MOMENT. TAKE A COFFEE.</view><view wx:if="{{pending}}" class="note-box pending-tip">上次提交结果待确认。点击下方按钮恢复同一笔订单，避免重复下单。</view><view class="pickup-store"><view>到店自取 · {{store.name}}</view><view class="muted">{{store.address}}</view><view class="muted">下单后约 {{store.pickup_minutes}} 分钟可取，请留意订单状态</view></view><view wx:for="{{items}}" wx:key="key" class="order-item"><image class="product-photo" src="{{item.image}}" mode="aspectFill"/><view class="item-info"><view>{{item.name}}</view><view class="muted">{{item.specification || '每日现做'}}</view><view class="muted">× <text class="quantity-number">{{item.quantity}}</text></view></view><text class="item-price money">¥{{item.subtotal}}</text></view><view class="field"><text>取餐称呼</text><input maxlength="20" value="{{customerName}}" disabled="{{pending}}" placeholder="怎么称呼你（选填）" bindinput="nameInput"/></view><view class="field"><text>给咖啡师留言</text><input maxlength="200" value="{{note}}" disabled="{{pending}}" placeholder="口味偏好等（选填）" bindinput="noteInput"/></view><view class="field"><text>取餐时间</text><text class="muted">尽快制作</text></view><view class="notice">请确认门店与商品。提交后可在「订单」查看制作进度，凭取餐码到店领取。</view></view><view class="fixed-footer"><view class="total-row"><text>共 {{count}} 件商品</text><view>合计 <text class="total money money-total">¥{{total}}</text></view></view><button class="primary" bindtap="submit" loading="{{submitting}}" disabled="{{submitting || (!store.is_open && !pending)}}">{{pending ? '确认上次提交' : store.is_open ? '确认下单' : '门店暂未接单'}}<text class="arrow">→</text></button><view class="footer-note">直接提交订单 · 无在线支付</view></view></block>
</view>
