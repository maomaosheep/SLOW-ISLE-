.checkout-page{padding-bottom:calc(260rpx + env(safe-area-inset-bottom))}.checkout-title{font-size:54rpx;letter-spacing:3rpx;margin:5rpx 0 14rpx}.subtitle{font-size:20rpx;letter-spacing:2rpx;margin-bottom:45rpx}.pickup-store{border-top:1rpx solid #e6ded3;border-bottom:1rpx solid #e6ded3;padding:30rpx 0;font-size:28rpx}.pickup-store .muted{font-size:24rpx;margin-top:12rpx}.order-item{padding:32rpx 0;display:flex;align-items:flex-start;gap:24rpx;border-bottom:1rpx solid #e6ded3}.order-item image{width:140rpx;height:150rpx;border-radius:6rpx;flex-shrink:0}.item-info{flex:1;min-width:0;font-size:28rpx}.item-info .muted{font-size:23rpx;margin-top:12rpx}.field{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:30rpx 0;border-bottom:1rpx solid #e6ded3;font-size:26rpx}.field input{width:350rpx;text-align:right;font-size:25rpx}.field>text:first-child{flex-shrink:0}.notice{font-size:23rpx;color:#82776c;line-height:1.9;margin-top:32rpx}.total-row{display:flex;justify-content:space-between;align-items:center;font-size:25rpx;margin-bottom:25rpx}.total{margin-left:12rpx}.pending-tip{margin-bottom:30rpx}
