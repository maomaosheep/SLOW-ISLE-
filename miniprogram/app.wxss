@import "styles/numbers.wxss";
page{background:#f8f5ef;color:#302720;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
view,text,button,input,textarea,scroll-view{box-sizing:border-box}
/* Override WeChat's button[size=default] rule, including its implicit attribute. */
button{min-width:0;padding:0;border:0;border-radius:0;background:transparent;color:inherit;font-family:inherit;font-size:inherit;line-height:inherit;box-sizing:border-box}
button,button[size="default"],button[size="mini"]{width:auto;min-width:0;max-width:100%;margin:0}
button::after{border:0}button[disabled]{opacity:.5}image{display:block}
.page{min-height:100%;padding-bottom:32rpx}.pad{padding:40rpx 44rpx}.serif{font-family:Georgia,"Songti SC","SimSun",serif;font-weight:400}.eyebrow{font-family:Georgia,serif;font-size:20rpx;letter-spacing:4rpx;color:#82776c}.muted{color:#82776c}.price{color:#a26642}
.primary,.primary[size="default"]{display:flex;align-items:center;justify-content:space-between;width:100%;min-height:96rpx;padding:24rpx 32rpx;background:#302720;color:#f8f5ef;border-radius:8rpx;font-size:28rpx;text-align:left;letter-spacing:1rpx}.primary .arrow{font-size:36rpx;flex-shrink:0}
.secondary,.secondary[size="default"]{min-height:86rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #c9b9a7;border-radius:8rpx;font-size:26rpx;padding:20rpx 28rpx;width:100%}
.line{border-bottom:1rpx solid #e6ded3}.section-head{display:flex;justify-content:space-between;align-items:center;margin:44rpx 0 24rpx}.section-head .title{font-size:38rpx}.section-head .eyebrow{font-size:18rpx;letter-spacing:2rpx}.state{padding:120rpx 50rpx;text-align:center}.state-title{font-size:40rpx;margin-bottom:20rpx}.state-copy{font-size:26rpx;color:#82776c;line-height:1.9;margin-bottom:36rpx}.state .secondary{max-width:320rpx;margin:auto}
.plus,.plus[size="default"]{flex:0 0 56rpx;width:56rpx;min-width:56rpx;height:56rpx;min-height:56rpx;padding:0;margin:0;background:#302720;color:#f8f5ef;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:36rpx;line-height:1}
.pill{font-size:22rpx;border:1rpx solid #e0d6c9;border-radius:40rpx;padding:8rpx 20rpx;flex-shrink:0}.badge{display:inline-block;font-size:22rpx;color:#56654c;background:#e9ede4;border-radius:4rpx;padding:6rpx 16rpx}.footer-note{font-size:22rpx;color:#82776c;text-align:center;line-height:1.8;margin-top:22rpx}.fixed-footer{position:fixed;bottom:0;left:0;right:0;padding:24rpx 40rpx calc(24rpx + env(safe-area-inset-bottom));background:#f8f5ef;border-top:1rpx solid #e6ded3;z-index:10}.stepper{display:flex;gap:24rpx;align-items:center;flex-shrink:0}.stepper button,.stepper button[size="default"]{flex:0 0 58rpx;width:58rpx;height:64rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #e0d6c9;border-radius:4rpx;font-size:36rpx}.empty-icon{font-family:Georgia;font-size:80rpx;color:#a6937b;margin-bottom:24rpx}.product-photo{background:#eae2d7}.text-button{color:#a26642;font-size:26rpx;padding:12rpx}.note-box{font-size:24rpx;line-height:1.9;color:#82776c;background:#f0eae1;padding:24rpx;border-radius:6rpx}
