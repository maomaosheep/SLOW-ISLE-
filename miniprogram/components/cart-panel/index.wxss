@import "../../styles/numbers.wxss";
@import "../../styles/quantity.wxss";
@import "../../styles/stock.wxss";
.shade{position:fixed;top:0;right:0;bottom:0;left:0;z-index:100;display:flex;align-items:flex-end}
.backdrop{position:absolute;top:0;right:0;bottom:0;left:0;background:rgba(35,28,22,.4)}
.panel{position:relative;width:100%;max-height:82vh;box-sizing:border-box;padding:12rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;background:#f8f5ef;color:#302720;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.5}
.heading{display:flex;align-items:center;padding:24rpx 0;border-bottom:1rpx solid #e6ded3}
.heading-copy{flex:1;width:0;min-width:0}
.heading-title,.heading-note{display:block;white-space:nowrap}
.heading-title{font-family:Georgia,"Songti SC",serif;font-size:36rpx}
.heading-note{margin-top:6rpx;font-size:21rpx;color:#978778}
.heading-clear{flex:0 0 80rpx;text-align:center;font-size:23rpx;color:#82776c;line-height:64rpx}
.close{flex:0 0 64rpx;height:64rpx;margin-left:12rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#eee8df;font-size:38rpx;line-height:1}
.cart-list{max-height:44vh}
.cart-item{display:flex;align-items:flex-start;padding:28rpx 0;border-bottom:1rpx solid #e6ded3}
.cart-item:last-child{border-bottom:0}
.item-image{display:block;flex:0 0 112rpx;width:112rpx;height:136rpx;margin-right:24rpx;border-radius:8rpx;background:#eee8df}
.item-body{flex:1;width:0;min-width:0}
.item-name{font-size:27rpx;font-weight:500;line-height:1.5;word-break:break-all}
.item-spec{margin-top:8rpx;font-size:21rpx;color:#82776c;line-height:1.6;word-break:break-all}
.item-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:14rpx}
.item-price,.summary-total{color:#a26642}
.item-price{flex-shrink:0}
.quantity-control{display:flex;align-items:center;flex:0 0 176rpx;margin-left:12rpx}
.quantity-action{box-sizing:border-box;flex:0 0 56rpx;width:56rpx;height:56rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid #d6c7b5;border-radius:50%}
.quantity-add{background:#302720;border-color:#302720;color:#f8f5ef}
.quantity-value{flex:0 0 64rpx;width:64rpx;text-align:center}
.bottom{display:flex;align-items:center;justify-content:space-between;padding-top:24rpx;border-top:1rpx solid #e6ded3}
.summary{flex:1;min-width:0;width:0;padding-right:16rpx}
.summary-count{display:block;font-size:21rpx;color:#82776c}
.summary-total{display:block}
.checkout-action{flex:0 0 252rpx;height:88rpx;display:flex;align-items:center;justify-content:center;border-radius:8rpx;background:#302720;color:#f8f5ef;font-size:26rpx;white-space:nowrap}
.checkout-action text{margin-left:22rpx}
.is-disabled{opacity:.4}
.empty{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:28rpx}
.empty-image{width:64rpx;height:64rpx;margin-bottom:24rpx;opacity:.5}
.empty-note{margin-top:12rpx;font-size:23rpx;color:#82776c}
